# Copy to .env and fill in RESTRICTED, LOW-QUOTA keys only.
# EXPO_PUBLIC_ vars are inlined into the JS bundle at build time and are
# extractable from a shipped APK — see AGENT.md golden rule #2.

# NVIDIA NIM — primary reasoning
EXPO_PUBLIC_NIM_API_KEY=
EXPO_PUBLIC_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
EXPO_PUBLIC_NIM_MODEL=meta/llama-3.1-8b-instruct

# Groq — low-latency voice replies
EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_GROQ_BASE_URL=https://api.groq.com/openai/v1
EXPO_PUBLIC_GROQ_MODEL=llama-3.1-8b-instant

# Gemini Flash — long-context summarising
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EXPO_PUBLIC_GEMINI_MODEL=gemini-1.5-flash
